{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vh48: dev server",
      "type": "shell",
      "command": "bash scripts/start-local.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "vh48: open mockup",
      "type": "shell",
      "command": "open http://127.0.0.1:8080/mockups/vibe-hunt/index.html || xdg-open http://127.0.0.1:8080/mockups/vibe-hunt/index.html || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["vh48: dev server"],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    }
  ]
}
